# Copie para .env (nunca commitar). Valores reais ficam no painel do deploy e nos secrets do GitHub.
# scripts/setup copia este arquivo para .env só se o .env não existir; scripts/doctor lista o que falta.
# Obrigatórias (o doctor cobra): NEXT_PUBLIC_API_URL, DATABASE_URL, CORS_ORIGIN, MODEL_PROVIDER,
# MODEL_NAME, GEMINI_API_KEY, GROQ_API_KEY. Opcionais: TRUST_PROXY, TEST_DATABASE_URL.

# --- apps/web ---
# URL da API vista pelo navegador.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- apps/api ---
# Postgres no formato postgresql://USUARIO:SENHA@HOST:5432/BANCO (preencher com o banco real).
DATABASE_URL=
# Origem permitida no CORS: o endereço do front, sem barra no fim.
CORS_ORIGIN=http://localhost:3000
# Provedor e modelo do gerador de exercícios (D-20): gemini ou groq.
MODEL_PROVIDER=
MODEL_NAME=
# Chaves de cada provedor (só no .env local e nos secrets; nunca no repositório).
GEMINI_API_KEY=
GROQ_API_KEY=
# TRUST_PROXY (REQ-040, D-24): rate limit por IP. Vazio = usa o IP da conexão (padrão, local).
# 1 = lê o IP real de X-Forwarded-For; use SÓ atrás de proxy confiável que sobrescreve o header,
# senão qualquer cliente forja o IP e escapa do limite. Ver README.
TRUST_PROXY=

# --- testes ---
# Banco dos testes da API. Vazio = SQLite (padrão, D-27).
TEST_DATABASE_URL=
