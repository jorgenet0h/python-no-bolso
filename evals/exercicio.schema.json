{
  "$comment": "Schema do exercício gerado. Decisões em docs/decisoes-contrato.md (a spec não o fixa). Campos base = modelo de dados de docs/arquitetura.md; codigo_corrigido é exigido só em achar_bug.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["tipo", "nivel", "tema", "enunciado", "codigo", "opcoes", "gabarito", "saida_esperada", "explicacao", "explicacoes_por_opcao"],
  "properties": {
    "tipo": {"enum": ["prever_saida", "completar_lacuna", "ordenar_linhas", "achar_bug"]},
    "nivel": {"enum": ["iniciante", "intermediario", "avancado"]},
    "tema": {"enum": ["variaveis", "condicionais", "lacos", "listas", "funcoes", "strings", "dicionarios", "erros"]},
    "enunciado": {"type": "string", "minLength": 5, "maxLength": 500},
    "codigo": {"type": "string", "maxLength": 2000},
    "codigo_corrigido": {"type": "string", "minLength": 1, "maxLength": 2000},
    "opcoes": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "gabarito": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "integer", "minimum": 0, "maximum": 5}},
    "saida_esperada": {"type": "string", "maxLength": 500},
    "explicacao": {"type": "string", "minLength": 5, "maxLength": 1000},
    "explicacoes_por_opcao": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 500}}
  },
  "allOf": [
    {"if": {"properties": {"tipo": {"const": "achar_bug"}}}, "then": {"required": ["codigo_corrigido"]}}
  ]
}
